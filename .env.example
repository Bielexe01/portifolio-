# Copie este arquivo para .env e preencha.

# WhatsApp com DDI + DDD + número, só dígitos. Ex.: 5516999999999
# Vazio = o botão do WhatsApp não aparece no site.
VITE_WHATSAPP_NUMBER=

# Mensagem inicial (opcional).
VITE_WHATSAPP_MESSAGE=Olá, Vitor! Vi seu portfólio e quero conversar sobre um projeto.

# Endereço público do site, sem barra no final (opcional, melhora o SEO).
# Ex.: https://vitorgabriel.vercel.app
VITE_SITE_URL=
